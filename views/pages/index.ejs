    <script>
      const landscapeCover = document.getElementById('landscape-cover');
      const contentWrapper = document.getElementById('content-wrapper');
      
      window.addEventListener('orientationchange', function() {
        if (Math.abs(window.orientation) === 90) {
          // The device is in landscape mode.
          landscapeCover.style.visibility = 'visible';
          contentWrapper.style.display = 'none'; // hide the rest of the content
          console.log('landscape cover visible');
        } else {
          // The device is in portrait mode.
          landscapeCover.style.visibility = 'hidden';
          contentWrapper.style.display = 'block'; // show the rest of the content
          console.log('landscape cover hidden');
        }
      });
  
      // You may want to call the event handler once at the start to set the initial state correctly.
      window.dispatchEvent(new Event('orientationchange'));
    </script>
